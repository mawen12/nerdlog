{
    "configurations": [
        {
            "name": "Debug Journalctl",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["--lstreams", "localhost:22:journalctl"]
        },
        {
            "name": "Debug Sessions",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["-d", "--log-level=debug", "--metrics", "--sessions"]
        },
        {
            "name": "Run",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": [""]
        },
        {
            "name": "Version",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["-v"]   
        },
    ]
}