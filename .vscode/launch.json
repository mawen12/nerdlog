{
    "configurations": [
        
        {
            "name": "Debug Journalctl",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["--lstreams", "localhost:22:journalctl"]
        },
        {
            "name": "Debug MACOS",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["--lstreams", "localhost:22:/Users/mawen/logs/app.log"]
        },
        {
            "name": "Version",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/nerdlog",
            "cwd": "${workspaceFolder}",
            "env": {},
            "args": ["-v"]   
        },
    ]
}